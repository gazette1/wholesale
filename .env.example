# Supabase (public values are safe in the browser; service role and DB password are not)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Messaging
# Twilio accepts either credential pair for REST calls: TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET (preferred when both are set), or TWILIO_AUTH_TOKEN.
# TWILIO_AUTH_TOKEN is still required to verify inbound webhooks, because Twilio signs them with the auth token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
EMAIL_FROM=

# Property data
REALESTATEAPI_KEY=
PROPERTY_DATA_PROVIDER=mock   # mock | realestateapi

# App
APP_URL=http://localhost:3000
CRON_SECRET=

# Every date in the app is shown in this IANA time zone, whatever zone the server runs in (Vercel runs in UTC).
NEXT_PUBLIC_APP_TIMEZONE=America/New_York

# Only matters in production while a messaging or email provider is still "mock": the inbound webhook routes
# then require the header X-Webhook-Secret to equal this value, and return 401 when it is unset.
MOCK_WEBHOOK_SECRET=

# Voice (docs/INTEGRATIONS.md, Connecting voice). Uses the Twilio credentials from above.
VOICE_PROVIDER=mock   # mock | twilio
# Browser calling only: an API key signs the softphone token, and the TwiML app points at /api/webhooks/twilio/voice.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
